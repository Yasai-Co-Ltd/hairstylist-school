{
  "name": "beauty-school-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "stylelint \"src/**/*.scss\"",
    "lint:fix": "stylelint \"src/**/*.scss\" --fix",
    "format": "prettier --write .",
    "check": "pnpm lint && prettier --check . && pnpm build"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "sass": "^1.108.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "swiper": "^14.4.0"
  }
}
